<?xml version="1.0" encoding="utf-8"?>
<!-- Abood in Liwa: the web game inside one full-screen WebView. No internet permission: every file is in the APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.mja_py.aboodliwa">

    <!-- the bump when the car lands or rolls (navigator.vibrate) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Game">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
